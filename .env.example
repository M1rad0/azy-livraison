# AZY Livraison — exemples uniquement
# Copier ce fichier vers .env puis remplacer toutes les valeurs DUMMY/CHANGE_ME.
# Ne jamais committer le fichier .env réel.

COMPOSE_PROJECT_NAME=azy-livraison
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
APP_TIMEZONE=Indian/Antananarivo

# Frontend / API
FRONTEND_PORT=3000
API_PORT=8080
API_EXPOSED_PORT=8081
API_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL métier
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5433
POSTGRES_DB=azy_livraison
POSTGRES_USER=azy_dummy_user
POSTGRES_PASSWORD=CHANGE_ME_DUMMY_DATABASE_PASSWORD

# Compte initial — valeurs factices à remplacer avant le premier démarrage
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_DUMMY_ADMIN_PASSWORD

# Authentification
# Utiliser des secrets aléatoires longs et distincts dans le vrai fichier .env.
JWT_ACCESS_SECRET=CHANGE_ME_DUMMY_ACCESS_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=azy-livraison
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_SECRET=CHANGE_ME_DUMMY_REFRESH_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_SECURE=false

# Services géographiques internes Docker
OSRM_BASE_URL=http://osrm:5000
OSRM_PROVIDER_PROFILE=driving
OSRM_EXPOSED_PORT=8083
OSRM_MAX_TABLE_SIZE=250
OSRM_MAX_ROUTE_POINTS=250
OSRM_DATASET=madagascar-latest
OSRM_PREPARE_THREADS=2
ROUTING_CONNECT_TIMEOUT=2s
ROUTING_READ_TIMEOUT=30s
NOMINATIM_BASE_URL=http://nominatim:8080
NOMINATIM_USER_AGENT=AZY-Livraison/0.1 (replace-with-contact@example.invalid)
GEOCODING_PROVIDER=nominatim-local
GEOCODING_CACHE_ENABLED=true
GEOCODING_COUNTRY_CODE=mg
GEOCODING_ACCEPT_LANGUAGE=fr,mg,en
GEOCODING_RESULT_LIMIT=5
GEOCODING_CONNECT_TIMEOUT=2s
GEOCODING_READ_TIMEOUT=30s
GEOCODING_CACHE_TTL=30d

# Données OpenStreetMap
OSM_DATA_URL=https://download.geofabrik.de/africa/madagascar-latest.osm.pbf
OSM_DATA_FILE=/data/osm/madagascar-latest.osm.pbf
ROUTING_PRESET=MAIN_ROADS
NOMINATIM_EXPOSED_PORT=8082
NOMINATIM_PASSWORD=CHANGE_ME_DUMMY_NOMINATIM_PASSWORD
NOMINATIM_IMPORT_THREADS=2
NOMINATIM_WORKERS=2
NOMINATIM_WARMUP_ON_STARTUP=true
NOMINATIM_POSTGRES_SHARED_BUFFERS=512MB
NOMINATIM_POSTGRES_MAINTENANCE_WORK_MEM=1GB
NOMINATIM_POSTGRES_AUTOVACUUM_WORK_MEM=256MB
NOMINATIM_POSTGRES_WORK_MEM=10MB
NOMINATIM_POSTGRES_EFFECTIVE_CACHE_SIZE=2GB

# Fond de carte de développement — vérifier la politique du fournisseur avant mise en ligne
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Préréglages applicatifs à valider avec les conditions opérationnelles réelles
VEHICLE_MOTO_DEFAULT_MAX_WEIGHT_KG=30
VEHICLE_MOTO_DEFAULT_AVERAGE_SPEED_KMH=25
VEHICLE_BICYCLE_DEFAULT_MAX_WEIGHT_KG=10
VEHICLE_BICYCLE_DEFAULT_AVERAGE_SPEED_KMH=12

# Optimisation
OPTIMIZATION_TIME_LIMIT=5s
OPTIMIZATION_VEHICLE_ACTIVATION_PENALTY_METERS=1000
OPTIMIZATION_PICKUP_SERVICE_DURATION=10m
OPTIMIZATION_HUB_TRANSFER_DURATION=15m
OPTIMIZATION_DELIVERY_SERVICE_DURATION=5m
OPTIMIZATION_DELIVERY_WINDOW_EARLY_TOLERANCE=0m
OPTIMIZATION_DELIVERY_WINDOW_LATE_TOLERANCE=30m
ALLOW_CAPACITY_OVERRIDE=false

# Imports / exports
MAX_IMPORT_FILE_SIZE_MB=10
TEMP_EXPORT_TTL_MINUTES=30

# Justificatifs de versement (PDF ou image, stockés hors de Git)
PAYMENT_PROOF_STORAGE_PATH=/data/payment-proofs
PAYMENT_PROOF_MAX_FILE_SIZE_MB=10
MAX_MULTIPART_REQUEST_SIZE_MB=12
